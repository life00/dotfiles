#!/usr/bin/env bash

list_path="/home/user/.cfg/mpd/future.txt"
lofi_dir="/home/user/tmp/lofi/"

printf "Lofi Future list:\n\n%s\n\nDo you want to continue? (y/N): " "$(cat $list_path)"
read response1

if [[ -e "$list_path" && "$response1" == "y" ]]; then
  
  while read -r lofi_song; do

    yt-dlp -x --audio-quality 0 -o "${lofi_dir}%(title)s.%(ext)s" "$lofi_song"

    sleep 5 

  done <$list_path
  
  :>"$list_path"

fi

