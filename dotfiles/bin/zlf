## version 2
# simple version that can open only one ranger tab but you may specify multiple arguments to zoxide
if [[ -e "$@" ]]
then
	d="$@"
elif [[ -z "$@" ]]
then
	d="$HOME"
else
	d=$(zoxide query ${@})
fi

lf $d
