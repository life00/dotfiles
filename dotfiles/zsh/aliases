#!/bin/zsh

# aliases categorized config file

# this file contains aliases that are written in specific order
# they are separated in command groups to where they belong



alias ".."="cd .."
alias "..."="cd ../.."
alias "...."="cd ../../.."
alias "....."="cd../../../.."
alias "......."="cd ../../../.."
alias "~"="cd ~"
alias "/"="cd /"

alias "ls"="eza --icons"

alias "delta"="delta --pager less"
alias "diff"="delta" # don't put duplicate --pager argument

alias "lf"="zlf"

alias "R"="R --quiet --no-save"

alias "tree"="eza --icons -T"

alias "nmpc"="ncmpcpp"

alias "lv"="nvim"
alias "oc"="opencode --port"

alias "mv"="mv -v"

alias "cp"="cp -v"

alias "rm"="rm -v"

alias "e"="exit"

alias "mpi"="mpv --pause"

alias "cd"="z"
alias "cdi"="zi"

alias "calc"="qalc"

alias "ef"="exiftool"

alias "btop"="bottom"

alias "todo"="rg '\- \[ \] ' --sortr 'modified' --glob '*.md' '/home/user/doc/'"
alias "td"="todo"
