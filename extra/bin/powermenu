#!/usr/bin/env bash
uptime=$(uptime -p | sed -e 's/up //g')

shutdown="󰐥 Shutdown"
reboot="󰜉 Restart"
lock="󰍁 Lock"
suspend="󰒲 Sleep"

options="$shutdown\n$reboot\n$suspend\n$lock"

chosen="$(echo -e "$options" | rofi -p "UP - $uptime" -dmenu -selected-row 0)"
case $chosen in
    $shutdown)
	    /home/user/.bin/ctrlcache get
	    systemctl poweroff
        ;;
    $reboot)
	    /home/user/.bin/ctrlcache get
	    systemctl reboot
        ;;
    $lock)
	    /home/user/.bin/ctrlcache get
	    /home/user/.bin/screenctl lock
        ;;
    $suspend)
	    mpc -q pause
	    /home/user/.bin/ctrlcache get
	    systemctl suspend
        ;;
esac