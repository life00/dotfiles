#!/usr/bin/env bash
chosen=$(printf '%s\n' '⏳  timer' '🖩  calculator ' '😄  emoji ' '💀  killer ' | rofi -dmenu -p ' utilities ' -selected-row 0)
case $chosen in
*timer*) /home/user/.bin/timer ;;
*calculator*) rofi -show calc -modi calc ;;
*emoji*) rofi -show emoji -modi emoji ;;
*killer*) /home/user/.bin/killer ;;
esac
