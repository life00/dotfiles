### extensions

# zoxide

cmd z %{{
    result="$(zoxide query --exclude "$PWD" "$@" | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$result\""
}}

cmd zi ${{
    result="$(zoxide query -i | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$result\""
}}

cmd on-cd &{{
    zoxide add "$PWD"

    # git branch (or detached sha) leading the prompt, so file names don't move it
    branch="$(git branch --show-current 2>/dev/null || true)"
    [ -n "$branch" ] || branch="$(git rev-parse --short HEAD 2>/dev/null || true)"
    git=""
    [ -z "$branch" ] || git="\033[35m $(printf '%s' "$branch" | sed 's/\\/\\\\/g;s/"/\\"/g')\033[0m "
    fmt="$git\033[32;1m%u@%h\033[0m:\033[34;1m%d\033[0m\033[1m%f\033[0m"
    lf -remote "send $id set promptfmt \"$fmt\""
}}
on-cd

# fzf

cmd fzf_jump ${{
    res="$(fd --max-depth 1 --hidden| fzf --reverse --header="Jump to location")"
    if [ -n "$res" ]; then
        if [ -d "$res" ]; then
            cmd="cd"
        else
            cmd="select"
        fi
        res="$(printf '%s' "$res" | sed 's/\\/\\\\/g;s/"/\\"/g')"
        lf -remote "send $id $cmd \"$res\""
    fi
}}

cmd fzf_jump_deep ${{
    res="$(fd --hidden | fzf --reverse --header="Jump to location")"
    if [ -n "$res" ]; then
        if [ -d "$res" ]; then
            cmd="cd"
        else
            cmd="select"
        fi
        res="$(printf '%s' "$res" | sed 's/\\/\\\\/g;s/"/\\"/g')"
        lf -remote "send $id $cmd \"$res\""
    fi
}}

# fzf searching
cmd fzf_search ${{
    cmd="rg --hidden --column --line-number --no-heading --color=always --smart-case"
    
    fzf --ansi --disabled --layout=reverse --header="Search in files" --delimiter=: \
        --bind="start:reload([ -n {q} ] && $cmd -- {q} || true)" \
        --bind="change:reload([ -n {q} ] && $cmd -- {q} || true)" \
        \
        --bind='ctrl-/:toggle-preview' \
        \
        --bind='enter:become(lf -remote "send $id select \"$(printf "%s" {1} | sed '\''s/\\/\\\\/g;s/"/\\"/g'\'')\"" && $EDITOR +{2} {1})' \
        \
        --preview='bat --style=full --color=always --highlight-line={2} -- {1}' \
        --preview-window='~4,+{2}+4/3,<80(up)'
}}

