# fzf marks
cmd fzf_marks ${{
    selected_line="$(cat ~/.local/share/lf/marks | fzf --no-sort --prompt="Jump to Mark: ")"
    mark_path="$(echo "$selected_line" | sed 's/..//')"
    if [ -n "$mark_path" ]; then
        lf -remote "send $id cd '$mark_path'"
    fi
}}

