   OrtHardwareDevice gpu_device{};
   const auto& sysfs_path = path_info.path;
 
+  // Apple Silicon GPU (asahi DRM driver) is a platform device without PCI vendor/device attributes.
+  std::error_code driver_ec{};
+  const bool is_asahi = fs::canonical(sysfs_path / "device" / "driver", driver_ec).filename() == "asahi";
+
   // vendor id
-  uint16_t vendor_id{};
